{
  "name": "avox",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "assemble:staging": "cd android && EXPO_PUBLIC_ENV=staging ./gradlew assembleStagingRelease && cd ..",
    "assemble:production": "cd android && EXPO_PUBLIC_ENV=production ./gradlew assembleProductionRelease && cd ..",
    "bundle:staging": "cd android && EXPO_PUBLIC_ENV=staging ./gradlew bundleStagingRelease && cd ..",
    "bundle:production": "cd android && EXPO_PUBLIC_ENV=production ./gradlew bundleProductionRelease && cd ..",
    "staging:android": "EXPO_PUBLIC_ENV=staging expo run:android --variant=stagingDebug",
    "staging:android:release": "EXPO_PUBLIC_ENV=staging expo run:android --variant=stagingRelease",
    "production:android": "EXPO_PUBLIC_ENV=production expo run:android --variant=productionDebug",
    "production:android:release": "EXPO_PUBLIC_ENV=production expo run:android --variant=productionRelease",
    "staging:ios": "EXPO_PUBLIC_ENV=staging expo run:ios --scheme 'Avox Staging'",
    "staging:ios:release": "EXPO_PUBLIC_ENV=staging expo run:ios --scheme 'Avox Staging' --configuration Staging",
    "production:ios": "EXPO_PUBLIC_ENV=production expo run:ios --scheme Avox",
    "production:ios:release": "EXPO_PUBLIC_ENV=production expo run:ios --scheme Avox --configuration Production",
    "postinstall": "patch-package",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:lint": "prettier --write . && expo lint --fix",
    "start:staging": "EXPO_PUBLIC_ENV=staging expo start --clear",
    "start:production": "EXPO_PUBLIC_ENV=production expo start --clear",
    "build:staging": "eas build --profile staging --platform all --auto-submit",
    "build:staging:android": "eas build --profile staging --platform android --auto-submit",
    "build:staging:ios": "eas build --profile staging --platform ios --auto-submit",
    "build:production": "eas build --profile production --platform all --auto-submit",
    "build:production:android": "eas build --profile production --platform android --auto-submit",
    "build:production:ios": "eas build --profile production --platform ios --auto-submit",
    "submit:staging:android": "eas submit --profile staging --platform android",
    "submit:staging:ios": "eas submit --profile staging --platform ios",
    "submit:production:android": "eas submit --profile production --platform android",
    "submit:production:ios": "eas submit --profile production --platform ios",
    "update:staging": "EXPO_PUBLIC_ENV=staging eas update --channel staging --message 'Staging update'",
    "update:production": "EXPO_PUBLIC_ENV=production eas update --channel production --message 'Production update'",
    "eas-build-pre-install": "npm config set legacy-peer-deps true",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:update-snapshots": "find . -name '*.snap' -delete && jest --updateSnapshot",
    "e2e:build:ios": "detox build --configuration ios.sim.debug",
    "e2e:test:ios": "detox test --configuration ios.sim.debug",
    "e2e:build:android": "detox build --configuration android.emu.debug",
    "e2e:test:android": "detox test --configuration android.emu.debug",
    "e2e:maestro": "maestro test e2e/maestro",
    "storybook-generate": "sb-rn-get-stories"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@expo/metro-runtime": "^57.0.16",
    "@expo/react-native-action-sheet": "^4.1.1",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^5.9.1",
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@likashefqet/react-native-image-zoom": "^4.3.0",
    "@react-native-community/datetimepicker": "^9.2.1",
    "@react-native-community/slider": "^5.2.1",
    "@react-native-firebase/analytics": "^26.4.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/crashlytics": "^26.4.0",
    "@react-native-firebase/firestore": "^26.4.0",
    "@react-native-firebase/in-app-messaging": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@react-native-firebase/remote-config": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
