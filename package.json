    "react-native-svg-transformer": "^1.5.3",
    "react-native-toast-message": "^2.5.2",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "^0.13.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "3.4.13",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
