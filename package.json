    "@storybook/addon-ondevice-controls": "^10.6.0",
    "@storybook/react-native": "^10.6.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/detox": "^18.1.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.2.3",
