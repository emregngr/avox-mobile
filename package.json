    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-maps": "~57.0.3",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-store-review": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-tracking-transparency": "~57.0.2",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.4.2",
    "lottie-react-native": "^7.5.0",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
