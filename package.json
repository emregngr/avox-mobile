    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.14",
    "react-native": "0.86.3",
    "react-native-collapsible-tab-view": "^8.0.1",
    "react-native-device-info": "^15.0.2",
    "react-native-edge-to-edge": "^1.8.2",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-google-mobile-ads": "^17.0.0",
    "react-native-keyboard-controller": "^1.22.5",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-notifications": "^5.2.2",
    "react-native-pager-view": "^9.0.4",
